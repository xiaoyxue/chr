{
  "name": "@chr/render-harness",
  "private": true,
  "version": "0.1.0",
  "description": "Mock browser viewer and verification harness for the chr render server (IPC + WebRTC)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "verify": "node src/harness/verify.ts",
    "test": "node --test src/node/*.test.ts",
    "verify:browser": "node src/harness/browser.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "werift": "0.25.2"
  }
}
