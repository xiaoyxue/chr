FUSION_API_URL=https://localhost:50001
# For local ASP.NET HTTPS, trust its public certificate with NODE_EXTRA_CA_CERTS before starting Node.
# Set the same random key (at least 32 characters) as Fusion's LiveIntegration__ApiKey.
# Keep the actual key in .env.local on the onsite server, never in VITE_* variables.
FUSION_API_KEY=
# Folders the page may read by typed server path (":"-separated); defaults to the home directory.
LOCAL_FILES_ROOTS=
